{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CSES: run tests for current problem",
      "type": "shell",
      "command": "${workspaceFolder}/cses",
      "args": ["run", "${fileDirname}"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "CSES: run current problem interactively",
      "type": "shell",
      "command": "${workspaceFolder}/cses",
      "args": ["run", "${fileDirname}", "-i"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "CSES: submit current problem",
      "type": "shell",
      "command": "${workspaceFolder}/cses",
      "args": ["submit", "${fileDirname}"],
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
